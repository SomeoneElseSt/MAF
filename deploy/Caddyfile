# MAF reverse proxy. Caddy terminates HTTPS (certificates are automatic) and forwards to the
# app on 127.0.0.1:8000. Installed to /etc/caddy/Caddyfile by setup.sh and update.sh.
#
# PRIVACY: no logs at all. Access logging is OFF and must stay off, and the global block below discards Caddy's runtime log. Caddy only writes access logs when a `log`
# directive is present in a site block, and there is none below. Do not add one.

{
	# Caddy's own runtime/error log can include a visitor's IP (e.g. when the app is down), so it's discarded too.
	log {
		output discard
	}
}

www.maforum.net {
	redir https://maforum.net{uri} permanent
}

maforum.net {
	# Static files are linked with ?v=<content hash>, so a versioned URL never changes meaning.
	@versioned {
		path /static/*
		query v=*
	}
	header @versioned Cache-Control "public, max-age=31536000, immutable"

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Same-origin only. Pages have no inline <script> or style="" (the theme bootstrap lives in
		# /static/theme-init.js), so there is no 'unsafe-inline'. data: images: one CSS mask icon.
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'none'"
		-Server
	}

	reverse_proxy 127.0.0.1:8000 {
		# The app never needs visitor IPs, so don't pass them on.
		header_up -X-Forwarded-For
		header_up -X-Forwarded-Host
		header_up -X-Forwarded-Proto
		# A release restarts the app for a few seconds: hold requests until it's back instead of failing.
		lb_try_duration 10s
		lb_try_interval 250ms
	}

	# Still down after that: a "under maintenance" page that reloads itself, instead of a bare 502.
	handle_errors 502 503 504 {
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'"
		header Cache-Control no-store
		header Retry-After 5
		header -Server
		rewrite * /maintenance.html
		file_server {
			status 503
			root /etc/caddy
		}
	}
}
